<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    @page { margin: 32px; }
    body { font-family: DejaVu Sans, sans-serif; color: #1f2937; font-size: 12px; }
    h1 { margin: 0 0 8px; font-size: 24px; color: #111827; }
    h2 { margin: 24px 0 8px; font-size: 14px; color: #111827; }
    .header { border-bottom: 2px solid #2563eb; padding-bottom: 18px; }
    .muted { color: #6b7280; }
    .grid { width: 100%; margin-top: 22px; }
    .grid td { width: 50%; vertical-align: top; padding-right: 18px; }
    .label { color: #6b7280; font-size: 10px; text-transform: uppercase; }
    table { width: 100%; border-collapse: collapse; margin-top: 12px; }
    th, td { padding: 9px 8px; border-bottom: 1px solid #e5e7eb; text-align: left; }
    th { background: #f3f4f6; font-size: 10px; text-transform: uppercase; }
    .right { text-align: right; }
    .total td { font-weight: bold; font-size: 14px; border-bottom: 0; }
    .footer { margin-top: 28px; padding-top: 12px; border-top: 1px solid #e5e7eb; font-size: 10px; }
  </style>
</head>
<body>
  {% set subscription = invoice.subscription %}
  <div class="header">
    <h1>Facture {{ invoice.reference }}</h1>
    <div class="muted">Facture d’abonnement — {{ invoice.status.label() }}</div>
  </div>

  <table class="grid">
    <tr>
      <td>
        <div class="label">Entreprise facturée</div>
        <strong>{{ invoice.billingName ?: 'Non renseigné' }}</strong><br>
        {{ invoice.billingAddress ?: 'Adresse non renseignée' }}
      </td>
      <td>
        <div class="label">Informations de facture</div>
        Date d’émission : {{ invoice.issuedAt ? invoice.issuedAt|date('d/m/Y') : 'Non renseignée' }}<br>
        Échéance : {{ invoice.dueAt ? invoice.dueAt|date('d/m/Y') : 'Non renseignée' }}<br>
        Paiement : {{ invoice.paidAt ? invoice.paidAt|date('d/m/Y') : 'Non réglé' }}
      </td>
    </tr>
  </table>

  <h2>Détail de l’abonnement</h2>
  <table>
    <thead><tr><th>Libellé</th><th>Période</th><th class="right">Montant HT</th></tr></thead>
    <tbody>
      <tr>
        <td>{{ subscription.plan.name }}</td>
        <td>{{ subscription.billingPeriod.value == 'yearly' ? 'Annuel' : 'Mensuel' }}</td>
        <td class="right">{{ invoice.amountHt|number_format(2, ',', ' ') }} €</td>
      </tr>
    </tbody>
  </table>

  <table>
    <tr><td class="right">TVA</td><td class="right">{{ invoice.amountVat|number_format(2, ',', ' ') }} €</td></tr>
    <tr class="total"><td class="right">Total TTC</td><td class="right">{{ invoice.amountTtc|number_format(2, ',', ' ') }} €</td></tr>
  </table>

  <div class="footer">
    Période facturée : {{ invoice.periodStartsAt ? invoice.periodStartsAt|date('d/m/Y') : 'Non renseignée' }} — {{ invoice.periodEndsAt ? invoice.periodEndsAt|date('d/m/Y') : 'Non renseignée' }}<br>
    Référence Stripe : {{ invoice.providerInvoiceId ?: 'Non renseignée' }}
  </div>
</body>
</html>
