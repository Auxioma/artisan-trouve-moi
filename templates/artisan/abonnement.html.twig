{% block javascripts %}
  <script src="https://js.stripe.com/v3/"></script>
  <script>
    (() => {
      const buttons = document.querySelectorAll('[data-billing-period]');
      const note = document.querySelector('[data-billing-note]');

      const updatePeriod = (period) => {
        document.querySelectorAll('[data-monthly-price]').forEach((price) => {
          const label = price.nextElementSibling;
          price.textContent = `${price.dataset[`${period}Price`]} €`;
          label.textContent = label.dataset[`${period}Label`];
        });
        buttons.forEach((button) => {
          const selected = button.dataset.billingPeriod === period;
          button.classList.toggle('btn-dash-primary', selected);
          button.classList.toggle('btn-dash-ghost', !selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        note.textContent = period === 'yearly' ? 'Facturation annuelle.' : 'Facturation mensuelle, sans engagement.';
      };

      buttons.forEach((button) => button.addEventListener('click', () => updatePeriod(button.dataset.billingPeriod)));

      const paymentModal = document.querySelector('#payment-method-modal');
      const cardSubmit = document.querySelector('#stripe-test-card-submit');
      const cardMessage = document.querySelector('#stripe-card-message');
      let stripeCardNumber;
      let stripeClient;
      let setupIntentClientSecret;

      const showCardMessage = (message, isError = false) => {
        cardMessage.textContent = message;
        cardMessage.classList.remove('d-none', 'text-success', 'text-danger');
        cardMessage.classList.add(isError ? 'text-danger' : 'text-success');
      };

      paymentModal?.addEventListener('shown.bs.modal', async () => {
        if (stripeCardNumber) return;

        try {
          const response = await fetch('{{ path('app_artisan_abonnement_stripe_setup_intent') }}', { method: 'POST' });
          const payload = await response.json();
          if (!response.ok || !payload.client_secret) throw new Error(payload.error || 'Impossible d’initialiser Stripe.');

          stripeClient = Stripe('{{ stripe_public_key|e('js') }}');
          setupIntentClientSecret = payload.client_secret;
          const elements = stripeClient.elements();
          const stripeElementOptions = { style: { base: { color: '#17254a', fontFamily: 'Inter, sans-serif', fontSize: '16px' }, invalid: { color: '#dc3545' } } };
          stripeCardNumber = elements.create('cardNumber', stripeElementOptions);
          const stripeCardExpiry = elements.create('cardExpiry', stripeElementOptions);
          const stripeCardCvc = elements.create('cardCvc', stripeElementOptions);
          stripeCardNumber.mount('#stripe-card-number-element');
          stripeCardExpiry.mount('#stripe-card-expiry-element');
          stripeCardCvc.mount('#stripe-card-cvc-element');
          [stripeCardNumber, stripeCardExpiry, stripeCardCvc].forEach((element) => element.on('change', (event) => { if (event.error) showCardMessage(event.error.message, true); }));
        } catch (error) {
          showCardMessage(error.message, true);
        }
      });

      cardSubmit?.addEventListener('click', async () => {
        if (!stripeClient || !stripeCardNumber || !setupIntentClientSecret) return showCardMessage('Le formulaire Stripe n’est pas prêt.', true);

        cardSubmit.disabled = true;
        cardSubmit.textContent = 'Enregistrement…';
        const { setupIntent, error } = await stripeClient.confirmCardSetup(setupIntentClientSecret, { payment_method: { card: stripeCardNumber } });

        if (error || !setupIntent?.payment_method) {
          cardSubmit.disabled = false;
          cardSubmit.textContent = 'Enregistrer la carte';
          return showCardMessage(error?.message || 'Carte refusée.', true);
        }

        const response = await fetch('{{ path('app_artisan_abonnement_stripe_payment_method') }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{{ csrf_token('artisan_stripe_payment_method') }}' },
          body: JSON.stringify({ payment_method_id: setupIntent.payment_method }),
        });
        const payload = await response.json();
        if (!response.ok) {
          cardSubmit.disabled = false;
          cardSubmit.textContent = 'Enregistrer la carte';
          return showCardMessage(payload.error || 'Impossible d’enregistrer la carte.', true);
        }

        showCardMessage('Carte enregistrée pour votre abonnement.');
        window.setTimeout(() => window.location.reload(), 700);
      });
    })();
  </script>
{% endblock %}
